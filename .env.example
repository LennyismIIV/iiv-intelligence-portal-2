# IIV Intelligence Portal - environment variables
#
# Copy this file to `.env` for local development. On Render, these are set
# automatically by render.yaml (or you can override them in the dashboard).

# Express listen port. Render sets this automatically; locally defaults to 5000.
PORT=5000

# Node environment. Use "production" for prod builds, "development" for dev.
NODE_ENV=development

# Path to the SQLite database file.
# - Local dev:   leave blank or set to "data.db" (relative to project root)
# - Render prod: set to "/data/iiv.db" so the file lives on the persistent disk
DB_PATH=data.db

# Set to "true" to enable SO_REUSEPORT on listen() (Linux only, mostly for
# multi-process setups). Leave unset on Render and most cloud hosts.
# REUSE_PORT=false

# Required. Shared API key, and the login password when IIV_USERS is unset.
# The server exits on startup if this is missing or shorter than 8 characters,
# so a deploy without it never serves an open API. Generate one with:
#   openssl rand -base64 24
# Do not commit the real value. On Render, set it in the service Environment tab
# (render.yaml marks it sync: false) BEFORE deploying this version.
IIV_AUTH_SECRET=

# Optional named accounts. When set, the login form asks for username + password
# and IIV_AUTH_SECRET is only the API key (Authorization: Bearer or X-API-Key).
# Format: username:password,username2:password2
# Usernames: letters, numbers, . _ @ + - (case-sensitive). Passwords: 8+ characters.
# Passwords may contain colons. Commas separate accounts, so passwords cannot contain commas.
# IIV_USERS=lenny:replace-with-a-long-password

# Optional. Signs the session cookie. Defaults to IIV_AUTH_SECRET.
# Set this if you want to rotate the API key without logging everyone out.
# IIV_SESSION_SECRET=
